# Leave empty only for local Vite proxy. On Render Static Site set full API URL, e.g.:
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=

# Backend origin used by Vite proxy in local dev only
VITE_API_PROXY_TARGET=http://localhost:3001

# Optional, build only. Where the build reads the list of exams from, to write one HTML page per exam and the
# sitemap. Defaults to <VITE_API_BASE_URL>/api/content/lessons. Can also be the path of a JSON file in the same shape.
# SEO_LESSONS=
